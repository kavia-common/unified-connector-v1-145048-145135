# Base URL for the backend API (FastAPI)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional public websocket URL if backend supports real-time via WS
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional site URL (for future auth providers or redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Toggle mock auth for local development (true|false)
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
