# Frontend configuration for Unified Connector v1

# Base URL for the backend FastAPI service. Example: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Optional: If the backend issues bearer tokens via login, this is the storage key used for session token.
# You do not need to set this; it is documented here for clarity.
# SESSION_STORAGE_KEY is not read from env; token is stored in localStorage for demo scaffolding.
