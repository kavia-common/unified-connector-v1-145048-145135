# Public environment variables for the Unified Connector Frontend
# Copy this file to .env.local and adjust values for your environment.

# Base URL for the FastAPI backend service (e.g., http://localhost:8000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional WebSocket URL if backend exposes real-time endpoints (e.g., ws://localhost:8000/ws)
NEXT_PUBLIC_WS_URL=

# Public site URL for redirects (used by future auth integrations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable mock in-memory session (development convenience)
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
